<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.flourish.profile">
    <value nick="subtle" value="0"/>
    <value nick="balanced" value="1"/>
    <value nick="expressive" value="2"/>
    <value nick="custom" value="3"/>
  </enum>

  <enum id="org.gnome.shell.extensions.flourish.easing">
    <value nick="linear" value="0"/>
    <value nick="ease-out-quad" value="1"/>
    <value nick="ease-out-cubic" value="2"/>
    <value nick="ease-out-back" value="3"/>
  </enum>

  <enum id="org.gnome.shell.extensions.flourish.press-mode">
    <value nick="launches-only" value="0"/>
    <value nick="all-primary-clicks" value="1"/>
    <value nick="clicks-only" value="2"/>
  </enum>

  <enum id="org.gnome.shell.extensions.flourish.press-effect">
    <value nick="squash" value="0"/>
    <value nick="dim" value="1"/>
  </enum>

  <enum id="org.gnome.shell.extensions.flourish.launch-effect">
    <value nick="pulse" value="0"/>
    <value nick="bounce" value="1"/>
    <value nick="stretch" value="2"/>
    <value nick="stock" value="3"/>
  </enum>

  <enum id="org.gnome.shell.extensions.flourish.attention-effect">
    <value nick="pulse" value="0"/>
    <value nick="bounce" value="1"/>
    <value nick="stretch" value="2"/>
    <value nick="wiggle" value="3"/>
  </enum>

  <enum id="org.gnome.shell.extensions.flourish.dock-outline">
    <value nick="none" value="0"/>
    <value nick="light" value="1"/>
    <value nick="dark" value="2"/>
    <value nick="auto" value="3"/>
  </enum>

  <schema id="org.gnome.shell.extensions.flourish"
          path="/org/gnome/shell/extensions/flourish/">
    <key name="motion-profile" enum="org.gnome.shell.extensions.flourish.profile">
      <default>"subtle"</default>
      <summary>Current preset</summary>
    </key>

    <key name="custom-hover-enabled" type="b">
      <default>true</default>
      <summary>Use hover motion in Custom</summary>
    </key>
    <key name="custom-hover-scale" type="d">
      <default>1.04</default>
      <range min="1.0" max="2.0"/>
      <summary>Hover scale</summary>
    </key>
    <key name="custom-hover-dynamic-spacing" type="b">
      <default>false</default>
      <summary>Move neighboring icons apart on hover</summary>
    </key>
    <key name="custom-hover-lift" type="i">
      <default>0</default>
      <range min="0" max="16"/>
      <summary>Hover lift in pixels</summary>
    </key>
    <key name="custom-hover-duration" type="i">
      <default>160</default>
      <range min="80" max="800"/>
      <summary>Hover duration in milliseconds</summary>
    </key>
    <key name="custom-hover-easing" enum="org.gnome.shell.extensions.flourish.easing">
      <default>"ease-out-cubic"</default>
      <summary>Hover transition easing</summary>
    </key>
    <key name="custom-neighbor-radius" type="i">
      <default>1</default>
      <range min="1" max="3"/>
      <summary>Hover reach in icon steps</summary>
    </key>

    <key name="custom-press-enabled" type="b">
      <default>true</default>
      <summary>Use press feedback in Custom</summary>
    </key>
    <key name="custom-press-mode" enum="org.gnome.shell.extensions.flourish.press-mode">
      <default>"clicks-only"</default>
      <summary>Press feedback trigger</summary>
    </key>
    <key name="custom-press-effect" enum="org.gnome.shell.extensions.flourish.press-effect">
      <default>"dim"</default>
      <summary>Press feedback effect</summary>
    </key>
    <key name="custom-press-intensity" type="d">
      <default>0.35</default>
      <range min="0.0" max="1.0"/>
      <summary>Press intensity</summary>
    </key>
    <key name="custom-press-duration" type="i">
      <default>100</default>
      <range min="80" max="500"/>
      <summary>Press duration in milliseconds</summary>
    </key>

    <key name="custom-launch-enabled" type="b">
      <default>true</default>
      <summary>Use launch animation in Custom</summary>
    </key>
    <key name="custom-launch-effect" enum="org.gnome.shell.extensions.flourish.launch-effect">
      <default>"pulse"</default>
      <summary>Launch effect</summary>
    </key>
    <key name="custom-launch-intensity" type="d">
      <default>0.5</default>
      <range min="0.0" max="1.0"/>
      <summary>Launch effect intensity</summary>
    </key>
    <key name="custom-launch-speed" type="d">
      <default>0.65</default>
      <range min="0.30" max="1.0"/>
      <summary>Launch speed</summary>
    </key>
    <key name="custom-launch-repeat" type="b">
      <default>false</default>
      <summary>Repeat while starting</summary>
    </key>
    <key name="custom-launch-soften-repeats" type="b">
      <default>true</default>
      <summary>Reduce the intensity of repeated launch cycles</summary>
    </key>
    <key name="custom-launch-repeat-pause" type="i">
      <default>400</default>
      <range min="0" max="1000"/>
      <summary>Pause between launch repeats in milliseconds</summary>
    </key>
    <key name="custom-launch-max-duration" type="i">
      <default>8000</default>
      <range min="500" max="15000"/>
      <summary>Maximum launch repeat time in milliseconds</summary>
    </key>
    <key name="custom-bounce-decay" type="d">
      <default>0</default>
      <range min="0.0" max="1.0"/>
      <summary>Height kept by each further bounce</summary>
    </key>
    <key name="custom-pulse-count" type="i">
      <default>2</default>
      <range min="1" max="4"/>
      <summary>Pulse count</summary>
    </key>
    <key name="custom-stretch-elasticity" type="d">
      <default>0.7</default>
      <range min="0.0" max="1.0"/>
      <summary>Stretch effect elasticity</summary>
    </key>
    <key name="custom-attention-enabled" type="b">
      <default>true</default>
      <summary>Use the attention animation in Custom</summary>
    </key>
    <key name="custom-attention-effect" enum="org.gnome.shell.extensions.flourish.attention-effect">
      <default>"pulse"</default>
      <summary>Attention effect</summary>
    </key>
    <key name="custom-attention-intensity" type="d">
      <default>0.25</default>
      <range min="0.0" max="1.0"/>
      <summary>Attention effect intensity</summary>
    </key>
    <key name="custom-attention-speed" type="d">
      <default>0.6</default>
      <range min="0.30" max="1.0"/>
      <summary>Attention speed</summary>
    </key>
    <key name="custom-attention-cycles" type="i">
      <default>1</default>
      <range min="1" max="10"/>
      <summary>Cycles played at each attention reminder</summary>
    </key>
    <key name="custom-attention-cycle-pause" type="i">
      <default>120</default>
      <range min="0" max="1000"/>
      <summary>Pause between attention cycles in milliseconds</summary>
    </key>
    <key name="custom-attention-interval" type="i">
      <default>10</default>
      <range min="2" max="60"/>
      <summary>Seconds between two attention reminders</summary>
    </key>
    <key name="custom-attention-reminders" type="i">
      <default>3</default>
      <range min="1" max="30"/>
      <summary>Reminders before the attention animation stops</summary>
    </key>
    <key name="custom-attention-peek" type="b">
      <default>false</default>
      <summary>Show the attention animation while the dock is hidden</summary>
    </key>

    <key name="show-hover-background" type="b">
      <default>false</default>
      <summary>Show the hover background</summary>
      <description>When false, hide the hover tile behind the icon.</description>
    </key>

    <key name="show-focused-app-background" type="b">
      <default>false</default>
      <summary>Show the focused app background</summary>
      <description>Mark the app that owns the focused window in the dash or dock.</description>
    </key>

    <key name="dock-outline" enum="org.gnome.shell.extensions.flourish.dock-outline">
      <default>'none'</default>
      <summary>Dock outline</summary>
      <description>Draw a thin edge around the dock background. Auto follows the color scheme.</description>
    </key>

  </schema>
</schemalist>
